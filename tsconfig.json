{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,

    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"],
    }
  },
  "include": [
    "expo-env.d.ts",
    ".expo/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "app.config.ts"
  ],
  "exclude": ["node_modules"]
}